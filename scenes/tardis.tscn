; The TARDIS exterior (2.3 m, the origin on the floor in the middle of its base, the door on the front
; +Z like a cabinet's). Its model and door are built by tardis.gd when it enters the tree (they must
; be direct children for the highlight). Layer 4 and mask 196613 are what every pickable here has;
; PointerArea on layer 21 is what the point-and-grab raycast, and the screwdriver aimed at it, look for.
[node name="Tardis" type="RigidBody3D" groups=["spawned"]]
collision_layer = 4
collision_mask = 196613
mass = 150.0
physics_material_override = SubResource("PhysMat_tardis")
linear_damp = 4.0
angular_damp = 8.0
script = ExtResource("1_tardis")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.15, 0)
shape = SubResource("Shape_body")

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("2_highlight")

; The body's ORIGIN is at its middle, not on the floor: the screwdriver's cone (like the TV remote's) is
; measured to a collider's origin, and from the floor a box 2.3 m tall is 40 degrees below where the
; hand points at it.
[node name="PointerArea" type="StaticBody3D" parent="."]
